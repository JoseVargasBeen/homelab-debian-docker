# Copiar a .env (en cada stack o en Portainer > Stack > Environment variables)
# y rellenar. El archivo .env real NUNCA se sube a GitHub.

TZ=America/Bogota
DOMAIN=tudominio.com

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# WireGuard / Pi-hole
WG_HOST=micasa.duckdns.org
WG_PASSWORD_HASH=
PIHOLE_PASSWORD=

# Tailscale (clave reutilizable con etiqueta)
TS_AUTHKEY=

# Nextcloud
NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_DB_PASSWORD=

# WordPress
WP_DB_ROOT_PASSWORD=
WP_DB_PASSWORD=

# Vaultwarden (hash argon2 generado con: docker exec -it vaultwarden /vaultwarden hash)
VAULTWARDEN_ADMIN_TOKEN=

# n8n
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Samba
SAMBA_USER=
SAMBA_PASSWORD=

# Transmission
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=

# Netdata Cloud (opcional)
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=
